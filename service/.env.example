# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4100

# "HOST" or "HOST\INSTANCE" - same format Leads Tracker/Portal already use
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=SYNCAXIS_AUTHCENTER
DB_USER=syncaxisadmin
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=
JWT_EXPIRES_IN=8h

SESSION_TTL_HOURS=8
REVERIFY_INTERVAL_MINUTES=5
SSO_CODE_TTL_SECONDS=60

# Login throttling (architecture doc §12) - mirrors Portal's MAX_FAILED_LOGINS=3
MAX_FAILED_LOGINS=3

# Bootstrap script only (architecture doc §9.3 / §16.6) - never read outside `npm run seed`
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# One-time Portal user migration only (`npm run migrate:portal-users`) -
# READ-ONLY: this script never writes to Portal's database. Not read by the
# app itself.
PORTAL_DB_SERVER=
PORTAL_DB_NAME=
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_ENCRYPT=false
PORTAL_DB_TRUST_SERVER_CERTIFICATE=true

# Where start-iam.bat / stop-iam.bat write iam.log, iam.err.log and iam.pid.
# In production use a folder OUTSIDE the app folder (created automatically).
# Unset = a "logs" folder next to the scripts (fine for local dev).
# LOG_DIR=D:\Logs\syncaxis-iam
