<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Sign in · Syncaxis IAM Admin</title>
<style>
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; background: #2c3e50; height: 100vh; margin: 0; display: flex; align-items: center; justify-content: center; }
  .card { background: #fff; border-radius: 8px; padding: 32px; width: 320px; box-shadow: 0 10px 30px rgba(0,0,0,.25); }
  h1 { font-size: 18px; margin: 0 0 4px; }
  p.sub { color: #667; font-size: 13px; margin: 0 0 20px; }
  label { display: block; font-size: 12.5px; font-weight: 600; margin: 12px 0 4px; color: #34495e; }
  input { width: 100%; padding: 8px 10px; border: 1px solid #ccd2d8; border-radius: 4px; font-size: 14px; }
  button { width: 100%; margin-top: 18px; background: #2c3e50; color: #fff; border: none; padding: 9px; border-radius: 4px; font-size: 14px; cursor: pointer; }
  .error { background: #fde8e8; color: #a02020; padding: 8px 12px; border-radius: 4px; font-size: 13px; margin-bottom: 4px; }
</style>
</head>
<body>
  <div class="card">
    <h1>Syncaxis IAM</h1>
    <p class="sub">Admin console</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <form method="post" action="/admin-ui/login">
      <label>Username</label>
      <input type="text" name="username" required autofocus />
      <label>Password</label>
      <input type="password" name="password" required />
      <button type="submit">Sign in</button>
    </form>
  </div>
</body>
</html>
