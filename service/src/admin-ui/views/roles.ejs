<%- include('partials/header', { title: 'Roles', active: 'roles', authUser }) %>

<div class="card">
  <form method="post" action="/admin-ui/roles">
    <label style="display:inline-block;margin-right:12px;">Name <span style="color:#c0392b;">*</span> <input type="text" name="name" required /></label>
    <label style="display:inline-block;">Description <input type="text" name="description" /></label>
    <button type="submit" style="margin-left:8px;">Create role</button>
  </form>
</div>

<table>
  <thead><tr><th>Name</th><th>Description</th><th>Users</th><th>Permissions</th></tr></thead>
  <tbody>
  <% roles.forEach(function(r) { %>
    <tr class="row-link" data-href="/admin-ui/roles/<%= r.RoleId %>" style="cursor:pointer;">
      <td><%= r.Name %><% if (r.IsFullAccess) { %> <span class="badge role">full access</span><% } %></td>
      <td class="muted"><%= r.Description || '' %></td>
      <td><%= r.UserCount %></td>
      <td><%= r.PermissionCount %></td>
    </tr>
  <% }) %>
  </tbody>
</table>

<script nonce="<%= cspNonce %>">
  document.querySelectorAll('tr.row-link').forEach(function (row) {
    row.addEventListener('click', function () { location.href = row.dataset.href; });
  });
</script>

<%- include('partials/footer') %>
