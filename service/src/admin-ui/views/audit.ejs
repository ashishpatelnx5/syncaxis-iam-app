<%- include('partials/header', { title: 'Audit Log', active: 'audit', authUser }) %>

<div class="card">
  <form method="get" action="/admin-ui/audit">
    <label style="display:inline-block;margin-right:12px;">Event type
      <input type="text" name="eventType" value="<%= filters.eventType || '' %>" placeholder="e.g. LOGIN_FAILURE" />
    </label>
    <label style="display:inline-block;margin-right:12px;">App key
      <input type="text" name="appKey" value="<%= filters.appKey || '' %>" />
    </label>
    <button type="submit">Filter</button>
  </form>
</div>

<table>
  <thead><tr><th>When</th><th>Event</th><th>User</th><th>App</th><th>Detail</th><th>IP</th></tr></thead>
  <tbody>
  <% entries.forEach(function(e) { %>
    <tr>
      <td class="muted"><%= new Date(e.CreatedAt).toLocaleString() %></td>
      <td><%= e.EventType %></td>
      <td><%= e.Username || '—' %></td>
      <td><%= e.AppKey || '—' %></td>
      <td class="muted"><%= e.Detail || '' %></td>
      <td class="muted"><%= e.IpAddress || '' %></td>
    </tr>
  <% }) %>
  <% if (entries.length === 0) { %><tr><td colspan="6" class="muted">No matching events.</td></tr><% } %>
  </tbody>
</table>

<p>
  <% if (page > 1) { %><a href="?page=<%= page - 1 %>">&laquo; Newer</a><% } %>
  &nbsp;Page <%= page %>&nbsp;
  <% if (entries.length === pageSize) { %><a href="?page=<%= page + 1 %>">Older &raquo;</a><% } %>
</p>

<%- include('partials/footer') %>
